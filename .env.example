# OpenAI API Key
OPENAI_API_KEY=sk-...

# O alternativamente, Google Gemini
# GOOGLE_API_KEY=AIza...
# GEMINI_API_KEY=AIza...

# Configuración del proveedor LLM
# Opciones: "openai", "google", "auto" (por defecto)
LLM_PROVIDER=auto

# Modelo específico a usar (opcional)
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL=gemini-2.0-flash
